---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAmazonUrl } from '../lib/taxonomy';

const giftCategories = (await getCollection('categories')).sort((a, b) =>
  a.data.label.localeCompare(b.data.label)
);

const products = (await getCollection('products'))
  .filter((p) => (p.data.priceValue ?? 0) >= 100)
  .sort((a, b) => (b.data.priceValue ?? 0) - (a.data.priceValue ?? 0));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Gifts', item: `${Astro.site}gifts/` },
    { '@type': 'ListItem', position: 3, name: 'Luxury', item: canonicalURL.toString() },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Luxury Nurse Gifts',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.title, url: buildAmazonUrl(p.data.asin) })),
};
const faq = [
  { q: 'What is a high-end gift for a nurse?', a: 'For a premium nurse gift, think career-long or milestone items: a cardiology-grade stethoscope, fine engraved jewelry, a designer work bag, a high-end smartwatch, or a quality timepiece. These suit graduations, retirements, and major thank-yous.' },
  { q: 'What is a good luxury graduation or retirement gift for a nurse?', a: 'A top-tier stethoscope (like the Littmann Cardiology IV), engraved keepsake jewelry, or a premium bag or watch all make excellent milestone gifts. For retirement, a personalized keepsake paired with an experience or travel gift is especially meaningful.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---

<BaseLayout
  title="Luxury Nurse Gifts ($100+) – Premium Picks for Big Milestones"
  description="The best luxury nurse gifts over $100 — premium stethoscopes, fine jewelry, designer bags, and milestone-worthy picks for graduations, retirements, and major thank-yous."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <nav class="breadcrumb"><a href="/">Home</a><span>›</span><a href="/gifts/">Gifts</a><span>›</span>Luxury</nav>

  <section class="category-hero">
    <span class="tag">By Budget</span>
    <h1>Luxury Nurse Gifts ($100+)</h1>
    <p>When the occasion calls for something special — a graduation, a retirement, a major thank-you — these premium nurse gifts deliver. Think career-long tools, fine keepsakes, and milestone-worthy picks worth the splurge.</p>
  </section>

  <div class="product-grid">
    {products.map((product) => (
      <article class="product-card">
        <a href={buildAmazonUrl(product.data.asin)} target="_blank" rel="nofollow sponsored noopener">
          <div class="product-image"><img src={product.data.image} alt={product.data.title} loading="lazy" decoding="async" width="300" height="300" /></div>
          <div class="product-info">
            <h3 class="product-title">{product.data.title}</h3>
            <div class="product-meta">{product.data.price && <span class="product-price">{product.data.price}</span>}</div>
            <span class="product-cta">View on Amazon</span>
          </div>
        </a>
      </article>
    ))}
  </div>

  <section class="faq">
    <h2>Frequently Asked Questions</h2>
    {faq.map((item, i) => (<details class="faq-item" open={i === 0}><summary>{item.q}</summary><p>{item.a}</p></details>))}
  </section>

  <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Shop nurse gifts by category</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      {giftCategories.map((c) => (<a class="tag" href={`/gifts/${c.slug}/`} style="text-decoration: none;">{c.data.label}</a>))}
    </div>
  </section>
</BaseLayout>
