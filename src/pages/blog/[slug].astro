---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAmazonUrl } from '../../lib/taxonomy';
import { matchProducts, popularProducts, relatedCategories, matchHubs } from '../../lib/match.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

/**
 * Product placement is computed at BUILD TIME from the post's title,
 * description and category — no markdown is edited. That is what makes it
 * possible to monetize 320 existing posts in one change, and it means every
 * product added later shows up in every relevant older post automatically.
 */
const allCategories = await getCollection('categories');
const allProducts = await getCollection('products');
const allHubs = await getCollection('hubs');

const matched = matchProducts({ ...post.data, slug: post.slug }, allProducts, 6);

// Posts about the idea of gifting rather than a product category get featured
// products under an honestly different heading, instead of a forced match.
const isMatched = matched.length > 0;
// Seeded by slug so fallback posts don't all render an identical block.
const shopProducts = isMatched ? matched : popularProducts(allProducts, 6, post.slug);

// Internal links derived from what actually matched, replacing the old block
// that linked all 9 categories from every post regardless of subject. Fallback
// posts derive theirs from the rotated product set, so those vary too.
const giftCategories = relatedCategories(shopProducts, allCategories, 4);

const relatedHubs = matchHubs({ ...post.data, slug: post.slug }, allHubs, 3);

// Pick up to 3 related posts (same category, fallback to recent)
const allPosts = (await getCollection('blog')).filter(
  (p) => !p.data.draft && p.slug !== post.slug
);
let related = post.data.category
  ? allPosts.filter((p) => p.data.category === post.data.category)
  : [];
if (related.length < 3) {
  related = [
    ...related,
    ...allPosts.filter((p) => !related.includes(p)),
  ];
}
related = related
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${Astro.site}blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalURL.toString() },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  ...(post.data.heroImage && { image: new URL(post.data.heroImage, Astro.site).toString() }),
  publisher: {
    '@type': 'Organization',
    name: '4aNurse',
    url: Astro.site?.toString() ?? 'https://4anurse.com',
  },
  mainEntityOfPage: canonicalURL.toString(),
};
---

<BaseLayout
  title={`${post.data.title} – 4aNurse`}
  description={post.data.description}
  image={post.data.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>

  <nav class="breadcrumb">
    <a href="/">Home</a><span>›</span><a href="/blog/">Blog</a><span>›</span>{post.data.title}
  </nav>

  <section class="category-hero" style="text-align: left;">
    {post.data.category && <span class="tag">{post.data.category}</span>}
    <h1 style="text-align: left;">{post.data.title}</h1>
    <p style="text-align: left; margin: 0 0 1rem 0;">{post.data.description}</p>
    <div class="post-meta" style="border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
      <span>{fmtDate(post.data.pubDate)}</span>
      {post.data.readTime && <span class="read-time">{post.data.readTime}</span>}
    </div>
  </section>

  {post.data.heroImage && (
    <div style="max-width: 960px; margin: 1rem auto 2rem; padding: 0 1.5rem;">
      <img
        src={post.data.heroImage}
        alt={post.data.title}
        width="960"
        height="540"
        decoding="async"
        style="border-radius: var(--radius); aspect-ratio: 16 / 9; object-fit: cover; width: 100%;"
      />
    </div>
  )}

  <article class="blog-post">
    <Content />
  </article>

  {shopProducts.length > 0 && (
    <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
      <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
        {isMatched ? 'Shop the picks in this guide' : 'Popular nurse gifts'}
      </h2>
      <p style="color: var(--color-muted); margin-bottom: 1.5rem; font-size: 0.95rem;">
        {isMatched
          ? 'Hand-picked products related to this guide. As an Amazon Associate we earn from qualifying purchases.'
          : 'Reader favourites from our gift collection. As an Amazon Associate we earn from qualifying purchases.'}
      </p>
      <div class="product-grid">
        {shopProducts.map((product) => (
          <article class="product-card">
            <a href={buildAmazonUrl(product.data.asin)} target="_blank" rel="nofollow sponsored noopener">
              <div class="product-image">
                <img src={product.data.image} alt={product.data.title} loading="lazy" decoding="async" width="300" height="300" />
              </div>
              <div class="product-info">
                <h3 class="product-title">{product.data.title}</h3>
                <div class="product-meta">
                  {product.data.price && <span class="product-price">{product.data.price}</span>}
                </div>
                <span class="product-cta">View on Amazon</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {(giftCategories.length > 0 || relatedHubs.length > 0) && (
    <section style="max-width: 1100px; margin: 2.5rem auto 0; padding: 0 1.5rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Browse related gifts</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        {giftCategories.map((c) => (
          <a class="tag" href={`/gifts/${c.slug}/`} style="text-decoration: none;">{c.data.label}</a>
        ))}
        {relatedHubs.map((h) => (
          <a class="tag" href={`/${h.slug}/`} style="text-decoration: none;">{h.data.breadcrumbLabel}</a>
        ))}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
      <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Keep reading</h2>
      <div class="posts-grid">
        {related.map((r) => (
          <a class="post-card" href={`/blog/${r.slug}/`}>
            <div class="post-card-image">
              <img src={r.data.heroImage || '/images/blog-placeholder.svg'} alt={r.data.title} loading="lazy" decoding="async" width="400" height="225" />
            </div>
            {r.data.category && <span class="tag">{r.data.category}</span>}
            <h3>{r.data.title}</h3>
            <div class="post-meta">
              <span>{fmtDate(r.data.pubDate)}</span>
              {r.data.readTime && <span class="read-time">{r.data.readTime}</span>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
