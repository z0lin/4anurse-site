---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { POSTS_PER_PAGE, pageHref, totalPages } from '../../lib/pagination';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];

// This page rendered all 319 post cards and 321 images — 194 KB, the heaviest
// document on the site. Paginated to POSTS_PER_PAGE; the rest live under
// /blog/page/N/. Every post stays in the sitemap, so nothing is deindexed.
const rest = posts.filter((p) => p.slug !== featuredPost?.slug);
const recentPosts = rest.slice(0, POSTS_PER_PAGE);
const pageCount = totalPages(rest.length);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Blog – 4aNurse"
  description="Gift guides, nursing stories, and ideas for showing appreciation."
>
  <section class="blog-hero">
    <h1>The Blog</h1>
    <p>Gift guides, nursing stories, and ideas for the nurses we love.</p>
  </section>

  {featuredPost && (
    <section class="featured-post">
      <a class="featured-post-card" href={`/blog/${featuredPost.slug}`}>
        <div class="featured-post-image">
          <img
            src={featuredPost.data.heroImage || '/images/blog-placeholder.svg'}
            alt={featuredPost.data.title}
            loading="eager"
            decoding="async"
            width="800"
            height="450"
          />
        </div>
        <div class="featured-post-content">
          <span class="tag">Featured{featuredPost.data.category ? ` · ${featuredPost.data.category}` : ''}</span>
          <h2>{featuredPost.data.title}</h2>
          <p>{featuredPost.data.description}</p>
          <div class="post-meta">
            <span>{fmtDate(featuredPost.data.pubDate)}</span>
            {featuredPost.data.readTime && <span class="read-time">{featuredPost.data.readTime}</span>}
          </div>
        </div>
      </a>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="posts-section">
      <h2>Recent Posts</h2>
      <div class="posts-grid">
        {recentPosts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}`}>
            <div class="post-card-image">
              <img
                src={post.data.heroImage || '/images/blog-placeholder.svg'}
                alt={post.data.title}
                loading="lazy"
                decoding="async"
                width="400"
                height="225"
              />
            </div>
            {post.data.category && <span class="tag">{post.data.category}</span>}
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-meta">
              <span>{fmtDate(post.data.pubDate)}</span>
              {post.data.readTime && <span class="read-time">{post.data.readTime}</span>}
            </div>
          </a>
        ))}
      </div>

      {pageCount > 1 && (
        <nav class="pagination" aria-label="Blog pages" style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 2.5rem;">
          <span style="color: var(--color-muted); font-size: 0.95rem;">Page 1 of {pageCount}</span>
          {Array.from({ length: pageCount }, (_, i) => i + 1)
            .filter((n) => n <= 5 || n === pageCount)
            .map((n) => (
              <a
                class="tag"
                href={pageHref(n)}
                aria-current={n === 1 ? 'page' : undefined}
                style={`text-decoration: none;${n === 1 ? ' font-weight: 600;' : ''}`}
              >{n}</a>
            ))}
          <a class="tag" href={pageHref(2)} style="text-decoration: none;" rel="next">Next →</a>
        </nav>
      )}
    </section>
  )}

  <section class="newsletter">
    <h2>One thoughtful gift idea a week.</h2>
    <p>Curated picks delivered to your inbox. No spam, unsubscribe anytime.</p>
    <!--
      Replace this form's action with your Buttondown/ConvertKit/Mailchimp endpoint.
      Buttondown example: action="https://buttondown.email/api/emails/embed-subscribe/YOUR_USERNAME" method="post"
    -->
    <form class="newsletter-form" action="#" method="post">
      <input type="email" name="email" placeholder="you@example.com" required />
      <button type="submit">Subscribe</button>
    </form>
  </section>
</BaseLayout>
