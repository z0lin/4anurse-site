---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAmazonUrl } from '../lib/taxonomy';

export async function getStaticPaths() {
  const hubs = await getCollection('hubs');
  return hubs.map((hub) => ({ params: { hub: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const { Content } = await hub.render();

// Featured products from this hub's relevant categories (deduped, cheapest first, capped)
const allProducts = await getCollection('products');
const products = allProducts
  .filter((p) => hub.data.productCategories.includes(p.data.category))
  .sort((a, b) => (a.data.priceValue ?? 0) - (b.data.priceValue ?? 0))
  .slice(0, 8);

// Related guides: blog posts whose slug matches any of the hub's keywords
const kws = hub.data.matchKeywords.map((k) => k.toLowerCase());
const relatedPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && kws.some((k) => p.slug.toLowerCase().includes(k)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 9);

// Gift category pages for the "shop by category" strip
const giftCategories = (await getCollection('categories')).sort((a, b) =>
  a.data.label.localeCompare(b.data.label)
);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Gifts', item: `${Astro.site}gifts/` },
    { '@type': 'ListItem', position: 3, name: hub.data.breadcrumbLabel, item: canonicalURL.toString() },
  ],
};

const itemListSchema = products.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: hub.data.h1,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: buildAmazonUrl(p.data.asin),
      })),
    }
  : null;

const faqSchema = hub.data.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: hub.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
---

<BaseLayout title={hub.data.title} description={hub.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}

  <nav class="breadcrumb">
    <a href="/">Home</a><span>›</span><a href="/gifts/">Gifts</a><span>›</span>{hub.data.breadcrumbLabel}
  </nav>

  <section class="category-hero">
    <span class="tag">Gift Guide</span>
    <h1>{hub.data.h1}</h1>
    <p>{hub.data.description}</p>
  </section>

  <section class="intro-content">
    <Content />
  </section>

  {products.length > 0 && (
    <div class="product-grid">
      {products.map((product) => (
        <article class="product-card">
          <a href={buildAmazonUrl(product.data.asin)} target="_blank" rel="nofollow sponsored noopener">
            <div class="product-image">
              <img src={product.data.image} alt={product.data.title} loading="lazy" decoding="async" width="300" height="300" />
            </div>
            <div class="product-info">
              <h3 class="product-title">{product.data.title}</h3>
              <div class="product-meta">
                {product.data.price && <span class="product-price">{product.data.price}</span>}
              </div>
              <span class="product-cta">View on Amazon</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  )}

  {relatedPosts.length > 0 && (
    <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
      <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">More {hub.data.breadcrumbLabel.toLowerCase()} guides</h2>
      <div class="posts-grid">
        {relatedPosts.map((r) => (
          <a class="post-card" href={`/blog/${r.slug}/`}>
            <div class="post-card-image">
              <img src={r.data.heroImage || '/images/blog-placeholder.svg'} alt={r.data.title} loading="lazy" decoding="async" width="400" height="225" />
            </div>
            {r.data.category && <span class="tag">{r.data.category}</span>}
            <h3>{r.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  {hub.data.faq && hub.data.faq.length > 0 && (
    <section class="faq">
      <h2>Frequently Asked Questions</h2>
      {hub.data.faq.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  )}

  <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Shop nurse gifts by category</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      {giftCategories.map((c) => (
        <a class="tag" href={`/gifts/${c.slug}/`} style="text-decoration: none;">{c.data.label}</a>
      ))}
    </div>
  </section>
</BaseLayout>
