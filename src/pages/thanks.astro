---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thanks for Your Submission — 4aNurse"
  description="We received your nurse gift idea. Thanks for sharing!"
>
  <div class="thanks-page">
    <div class="thanks-icon">✓</div>
    <h1>Got it, thanks!</h1>
    <p>We review every submission personally. If your idea makes it onto the site, we'll let you know.</p>
    <a href="/" class="btn-primary">Browse Nurse Gifts</a>
  </div>
</BaseLayout>

<style>
.thanks-page {
  max-width: 480px;
  margin: 6rem auto;
  padding: 0 1.5rem;
  text-align: center;
}
.thanks-icon {
  width: 64px;
  height: 64px;
  background: var(--color-accent);
  color: white;
  border-radius: 50%;
  font-size: 1.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
}
h1 {
  font-size: 2rem;
  margin-bottom: 0.75rem;
}
p {
  color: var(--color-muted);
  margin-bottom: 2rem;
  line-height: 1.7;
}
.btn-primary {
  display: inline-block;
  background: var(--color-accent);
  color: white;
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  transition: opacity 0.2s;
}
.btn-primary:hover { opacity: 0.88; }
</style>
