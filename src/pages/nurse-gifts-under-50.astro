---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAmazonUrl } from '../lib/taxonomy';

const giftCategories = (await getCollection('categories')).sort((a, b) =>
  a.data.label.localeCompare(b.data.label)
);

const products = (await getCollection('products'))
  .filter((p) => (p.data.priceValue ?? 0) > 0 && (p.data.priceValue ?? 0) < 50)
  .sort((a, b) => (b.data.priceValue ?? 0) - (a.data.priceValue ?? 0))
  .slice(0, 36);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Gifts', item: `${Astro.site}gifts/` },
    { '@type': 'ListItem', position: 3, name: 'Under $50', item: canonicalURL.toString() },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Nurse Gifts Under $50',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.title, url: buildAmazonUrl(p.data.asin) })),
};
const faq = [
  { q: 'What is a good gift for a nurse under $50?', a: 'Under $50 opens up nicer picks: a premium insulated tumbler, a quality 6-pack of compression socks, personalized jewelry or a custom sweatshirt, a self-care or spa set, and upgraded accessories. It is a sweet spot for a thoughtful gift that still feels generous.' },
  { q: 'How much should I spend on a nurse gift?', a: 'For a coworker or friend, $20–50 hits the mark for something useful and thoughtful. Close family and milestone occasions (graduation, retirement) often justify spending more on a keepsake or a career-long tool like a stethoscope.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---

<BaseLayout
  title="Nurse Gifts Under $50 – Thoughtful Picks That Feel Generous"
  description="The best nurse gifts under $50 — from premium tumblers and compression socks to personalized jewelry and self-care sets. Thoughtful, well-reviewed picks for any nurse."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <nav class="breadcrumb"><a href="/">Home</a><span>›</span><a href="/gifts/">Gifts</a><span>›</span>Under $50</nav>

  <section class="category-hero">
    <span class="tag">By Budget</span>
    <h1>Nurse Gifts Under $50</h1>
    <p>The sweet spot for a thoughtful gift that still feels generous. These nurse gifts under $50 range from premium drinkware and compression socks to personalized pieces and self-care sets — all well-reviewed and genuinely useful.</p>
  </section>

  <div class="product-grid">
    {products.map((product) => (
      <article class="product-card">
        <a href={buildAmazonUrl(product.data.asin)} target="_blank" rel="nofollow sponsored noopener">
          <div class="product-image"><img src={product.data.image} alt={product.data.title} loading="lazy" decoding="async" width="300" height="300" /></div>
          <div class="product-info">
            <h3 class="product-title">{product.data.title}</h3>
            <div class="product-meta">{product.data.price && <span class="product-price">{product.data.price}</span>}</div>
            <span class="product-cta">View on Amazon</span>
          </div>
        </a>
      </article>
    ))}
  </div>

  <section class="faq">
    <h2>Frequently Asked Questions</h2>
    {faq.map((item, i) => (<details class="faq-item" open={i === 0}><summary>{item.q}</summary><p>{item.a}</p></details>))}
  </section>

  <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Shop nurse gifts by category</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      {giftCategories.map((c) => (<a class="tag" href={`/gifts/${c.slug}/`} style="text-decoration: none;">{c.data.label}</a>))}
    </div>
  </section>
</BaseLayout>
