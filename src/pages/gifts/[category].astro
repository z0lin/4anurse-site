---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAmazonUrl, priceBand, passesGuard, PAGE_GUARD } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const categoryPages = await getCollection('categories');
  return categoryPages.map((cat) => ({
    params: { category: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const { Content } = await cat.render();

// A page declares which facet values it collects, so the route knows nothing
// about the taxonomy. `match` decides how the GROUPS combine: 'any' for broad
// pages (/gifts/accessories/ aggregates 7 types), 'all' for intersections
// (/gifts/drinkware-under-25/ needs drinkware AND under $25).
const { types, occasions, recipients, prices, match } = cat.data;
const allProducts = await getCollection('products');

const groupHits = (p: any) => {
  const hits: boolean[] = [];
  if (types.length) hits.push(types.includes(p.data.type));
  if (occasions.length) hits.push(occasions.some((o) => p.data.occasion.includes(o)));
  if (recipients.length) hits.push(recipients.some((r) => p.data.recipient.includes(r)));
  if (prices.length) hits.push(prices.includes(priceBand(p.data.priceValue) ?? ''));
  return hits;
};

const products = allProducts
  .filter((p) => {
    const hits = groupHits(p);
    return match === 'all' ? hits.every(Boolean) : hits.some(Boolean);
  })
  .sort((a, b) => a.data.priceValue - b.data.priceValue);

/**
 * Build-time guard against thin/doorway pages.
 *
 * An intersection that drops below the threshold because STOCK changed — not
 * because anyone edited the page — should fail the build loudly rather than
 * quietly ship a near-empty grid. That is the failure mode the guard exists for.
 *
 * `allowThin` grandfathers pre-existing URLs: /gifts/apparel/ has only 3
 * products but has been indexed since 2025, and deleting a ranking URL to
 * satisfy a rule we introduced later would be strictly worse than keeping it.
 */
const nonEmptyGroups = [types, occasions, recipients, prices].filter((g) => g.length).length;
const isIntersection = match === 'all' && nonEmptyGroups > 1;
if (!cat.data.allowThin && !passesGuard(products.length, isIntersection)) {
  const min = isIntersection
    ? PAGE_GUARD.minProductsIntersection
    : PAGE_GUARD.minProductsSingleFacet;
  throw new Error(
    `Thin page: /gifts/${cat.slug}/ has ${products.length} products, below the ${min} ` +
      `minimum for ${isIntersection ? 'an intersection' : 'a single-facet'} page. ` +
      `Add stock, widen the facets, or delete the page. ` +
      `Set allowThin: true only to grandfather an already-indexed URL.`
  );
}

/**
 * Child intersection pages, so they are reachable and inherit link equity from
 * the parent that already ranks. An intersection is a child when it selects a
 * superset of this page's facet values and narrows with at least one more.
 */
const allCategories = await getCollection('categories');
const facetSet = (d: any) => [
  ...(d.types ?? []), ...(d.occasions ?? []), ...(d.recipients ?? []), ...(d.prices ?? []),
];
const ownFacets = facetSet(cat.data);
const children = cat.data.hideFromHub
  ? []
  : allCategories.filter((c) => {
      if (c.slug === cat.slug || !c.data.hideFromHub) return false;
      const f = facetSet(c.data);
      return ownFacets.some((v) => f.includes(v)) && f.length > ownFacets.length;
    });

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Gifts', item: `${Astro.site}gifts/` },
    { '@type': 'ListItem', position: 3, name: cat.data.label, item: canonicalURL.toString() },
  ],
};

/**
 * ItemList, deliberately NOT Product.
 *
 * Product/Offer markup belongs on pages that sell the item. Affiliate roundups
 * publishing prices they do not control are a known enforcement target, and the
 * prices here are hand-maintained until PA-API access lands. ItemList describes
 * what this page actually is: a curated list.
 */
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: cat.data.title,
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: buildAmazonUrl(p.data.asin),
  })),
};

const faqSchema = cat.data.faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cat.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;
---

<BaseLayout
  title={`${cat.data.title} – 4aNurse`}
  description={cat.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}

  <nav class="breadcrumb">
    <a href="/">Home</a><span>›</span><a href="/gifts/">Gifts</a><span>›</span>{cat.data.label}
  </nav>

  <section class="category-hero">
    <span class="tag">Category</span>
    <h1>{cat.data.title}</h1>
    <p>{cat.data.description}</p>
  </section>

  <section class="intro-content">
    <Content />
  </section>

  {children.length > 0 && (
    <section style="max-width: 1100px; margin: 1.5rem auto 0; padding: 0 1.5rem;">
      <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Narrow it down</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        {children.map((c) => (
          <a class="tag" href={`/gifts/${c.slug}/`} style="text-decoration: none;">{c.data.label}</a>
        ))}
      </div>
    </section>
  )}

  <div class="filters" style="padding-top: 0.5rem;">
    <button class="price-pill active" data-range="all">All Prices</button>
    <button class="price-pill" data-range="under25">Under $25</button>
    <button class="price-pill" data-range="25to50">$25 – $50</button>
    <button class="price-pill" data-range="50to100">$50 – $100</button>
    <button class="price-pill" data-range="over100">$100+</button>
  </div>

  <div class="product-grid">
    {products.map((product) => (
      <article
        class="product-card"
        data-price={product.data.priceValue ?? 0}
      >
        <a href={buildAmazonUrl(product.data.asin)} target="_blank" rel="nofollow sponsored noopener">
          <div class="product-image">
            <!-- width/height are required to reserve space: without them every
                 category page shifted layout as remote Amazon images loaded. -->
            <img
              src={product.data.image}
              alt={product.data.title}
              loading="lazy"
              decoding="async"
              width="300"
              height="300"
            />
          </div>
          <div class="product-info">
            <h3 class="product-title">{product.data.title}</h3>
            <div class="product-meta">
              {product.data.price && <span class="product-price">{product.data.price}</span>}
            </div>
            <span class="product-cta">View on Amazon</span>
          </div>
        </a>
      </article>
    ))}
  </div>

  {cat.data.faq && cat.data.faq.length > 0 && (
    <section class="faq">
      <h2>Frequently Asked Questions</h2>
      {cat.data.faq.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  )}

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>('.price-pill');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const range = pill.dataset.range;
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        cards.forEach((card) => {
          const price = parseFloat(card.dataset.price || '0');
          let show = true;
          if (range === 'under25') show = price < 25;
          else if (range === '25to50') show = price >= 25 && price < 50;
          else if (range === '50to100') show = price >= 50 && price < 100;
          else if (range === 'over100') show = price >= 100;
          card.style.display = show ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
