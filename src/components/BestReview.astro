---
import { getCollection } from 'astro:content';

interface Pick {
  name: string;
  badge?: string;
  price?: string;
  blurb: string;
  url: string;
}
interface Faq { q: string; a: string }
interface Props {
  title: string;
  h1: string;
  description: string;
  breadcrumbLabel: string;
  listName: string;
  picks: Pick[];
  faq: Faq[];
}

const { title, h1, description, breadcrumbLabel, listName, picks, faq } = Astro.props as Props;

const giftCategories = (await getCollection('categories')).sort((a, b) =>
  a.data.label.localeCompare(b.data.label)
);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Gifts', item: `${Astro.site}gifts/` },
    { '@type': 'ListItem', position: 3, name: breadcrumbLabel, item: canonicalURL.toString() },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: listName,
  itemListElement: picks.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: p.url })),
};
const faqSchema = faq.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
  : null;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}

  <nav class="breadcrumb"><a href="/">Home</a><span>›</span><a href="/gifts/">Gifts</a><span>›</span>{breadcrumbLabel}</nav>

  <section class="category-hero">
    <span class="tag">Buyer's Guide</span>
    <h1>{h1}</h1>
    <p>{description}</p>
  </section>

  <section class="intro-content">
    <slot />
  </section>

  <section style="max-width: 820px; margin: 0 auto; padding: 1rem 1.5rem;">
    {picks.map((p, i) => (
      <div style="border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.25rem;">
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; justify-content: space-between;">
          <h2 style="font-size: 1.2rem; margin: 0;">{i + 1}. {p.name}</h2>
          {p.badge && <span class="tag">{p.badge}</span>}
        </div>
        <p style="margin: 0.75rem 0;">{p.blurb}</p>
        <a class="product-cta" href={p.url} target="_blank" rel="nofollow sponsored noopener">
          Check price on Amazon{p.price ? ` (${p.price})` : ''}
        </a>
      </div>
    ))}
  </section>

  {faq.length > 0 && (
    <section class="faq">
      <h2>Frequently Asked Questions</h2>
      {faq.map((item, i) => (<details class="faq-item" open={i === 0}><summary>{item.q}</summary><p>{item.a}</p></details>))}
    </section>
  )}

  <section style="max-width: 1100px; margin: 3rem auto 0; padding: 3rem 1.5rem 0; border-top: 1px solid var(--color-border);">
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Shop nurse gifts by category</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      {giftCategories.map((c) => (<a class="tag" href={`/gifts/${c.slug}/`} style="text-decoration: none;">{c.data.label}</a>))}
    </div>
  </section>
</BaseLayout>
