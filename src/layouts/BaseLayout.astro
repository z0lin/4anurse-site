---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /**
   * Robots directive. Paginated blog pages pass "noindex, follow": they carry no
   * unique content, but crawlers should still follow through to the posts.
   * A `slot="head"` meta tag does NOT work here — this layout has only a default
   * slot, so the tag would land in the body and be ignored.
   */
  robots?: string;
}

const {
  title,
  description = 'Thoughtful, hand-picked gift ideas for the nurses in your life. Curated by nurses, for nurses.',
  image = '/images/og-default.jpg',
  robots,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '4aNurse',
  url: Astro.site?.toString() ?? 'https://4anurse.com',
  description: 'Thoughtful, hand-picked gift ideas for the nurses in your life. Curated by nurses, for nurses.',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/Updatedlogo.png" />
  <link rel="canonical" href={canonicalURL} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="sitemap" href="/sitemap.xml" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="4aNurse" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />

  <link rel="alternate" type="application/rss+xml" title="4aNurse Blog" href="/rss.xml" />

  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!--
    Loaded off the critical path. As a plain stylesheet this blocked first render
    on a third-party connection; media="print" + onload swaps it in once fetched.
    The URL already carries display=swap, so text was always painting in the
    fallback face first — this changes when the request blocks, not what the user
    sees. <noscript> keeps it working without JS.
  -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" />
  </noscript>

  <!--
    Privacy-friendly analytics: self-hosted Plausible.

    REPLACES the previous hosted plausible.io tag rather than sitting alongside
    it. Two Plausible scripts on one page means every pageview is counted twice,
    in two different dashboards, and neither number is usable.

    No data-domain attribute here: this is Plausible's per-site script, so the
    site identity is baked into the filename (pa-...js) and setting data-domain
    as well would conflict with it.

    is:inline on both tags is load-bearing. Astro bundles <script> by default,
    which would rewrite the inline snippet and break the plausible.q queue that
    buffers events fired before the async script finishes loading.
  -->
  <script is:inline async src="https://analytics.thetelehealthnurse.com/js/pa-MrSTgGRmPITI9nYiHYpaT.js"></script>
  <script is:inline>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>

  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.init({
        APIUrl: "https://moonlit-croissant-d11744.netlify.app/.netlify/identity"
      });
      window.netlifyIdentity.on("init", function(user) {
        if (!user) {
          window.netlifyIdentity.on("login", function() {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo"><img src="/4anurselogo.png" alt="4aNurse" width="150" height="44" /></a>
      <nav class="nav">
        <a href="/">Gifts</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
        <a href="/contact/">Submit</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <h4>4aNurse</h4>
        <p style="font-size:0.9rem;">The perfect gift, prescribed for a nurse.</p>
      </div>
      <div>
        <h4>Browse</h4>
        <a href="/">All Gifts</a>
        <a href="/gifts/">Gift Categories</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">Our Story</a>
      </div>
      <div>
        <h4>Connect</h4>
        <a href="/contact/">Submit a Gift</a>
        <a href="mailto:contact@4anurse.com">contact@4anurse.com</a>
      </div>
      <div>
        <h4>Our Network</h4>
        <a href="https://illumivein.com/" rel="noopener">Illumivein — vein finders</a>
        <a href="https://telehealthnursenetwork.com/" rel="noopener">Telehealth Nurse Network</a>
      </div>
      <div>
        <h4>Legal</h4>
        <a href="/disclosure/">Affiliate Disclosure</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Use</a>
      </div>
    </div>
    <div class="disclosure">
      As an Amazon Associate, 4aNurse.com earns from qualifying purchases.<br />
      Copyright © {new Date().getFullYear()} · 4aNurse.com · A brand of Easy-RN, LLC
    </div>
  </footer>
</body>
</html>
